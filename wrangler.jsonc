{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "monthwise-production",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-19",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/auth/*"],
  },
  "vars": {
    "MODE": "production",
    "APP_ORIGIN": "",
    "OWNER_EMAIL": "fatlindnebihi10@gmail.com",
    "GOOGLE_CLIENT_ID": "",
    "ACCESS_MODE": "owner",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "monthwise-production",
      "database_id": "333feb62-aa82-41b7-8b03-7d330e45eff5",
      "migrations_dir": "migrations",
    },
  ],
  "env": {
    "local": {
      "name": "monthwise-local",
      "vars": {
        "MODE": "local",
        "APP_ORIGIN": "",
        "OWNER_EMAIL": "",
        "GOOGLE_CLIENT_ID": "",
        "ACCESS_MODE": "owner",
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "monthwise-local",
          "database_id": "00000000-0000-0000-0000-000000000001",
          "migrations_dir": "migrations",
        },
      ],
    },
    "staging": {
      "name": "monthwise-staging",
      "vars": {
        "MODE": "production",
        "APP_ORIGIN": "https://monthwise-staging.fnebihi10.workers.dev",
        "OWNER_EMAIL": "fatlindnebihi10@gmail.com",
        "GOOGLE_CLIENT_ID": "932682992741-ju7v0u16gbhu3j43fqdmt4fn6ndpsajh.apps.googleusercontent.com",
        "ACCESS_MODE": "owner",
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "monthwise-staging",
          "database_id": "33853f06-8e98-4422-89cb-4bd2221cc442",
          "migrations_dir": "migrations",
        },
      ],
      "workers_dev": true,
      "preview_urls": false,
    },
    "personal": {
      "name": "monthwise",
      "vars": {
        "MODE": "production",
        "APP_ORIGIN": "https://monthwise.fnebihi10.workers.dev",
        "OWNER_EMAIL": "fatlindnebihi10@gmail.com",
        "GOOGLE_CLIENT_ID": "932682992741-ju7v0u16gbhu3j43fqdmt4fn6ndpsajh.apps.googleusercontent.com",
        "ACCESS_MODE": "owner",
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "monthwise-staging",
          "database_id": "33853f06-8e98-4422-89cb-4bd2221cc442",
          "migrations_dir": "migrations",
        },
      ],
      "workers_dev": true,
      "preview_urls": false,
    },
    "public": {
      "name": "monthwise-public",
      "workers_dev": false,
      "preview_urls": false,
      "vars": {
        "MODE": "production",
        "ACCESS_MODE": "public",
        "APP_ORIGIN": "https://monthwise.online",
        "OWNER_EMAIL": "",
        "SUPPORT_EMAIL": "nebihifatlind@gmail.com",
        "GOOGLE_CLIENT_ID": "773217761093-9hj05p0rgieqpplsej2s2ds383o08f5f.apps.googleusercontent.com",
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "monthwise-production",
          "database_id": "333feb62-aa82-41b7-8b03-7d330e45eff5",
          "migrations_dir": "migrations",
        },
      ],
      "ratelimits": [
        {
          "name": "EDGE_LIMITER",
          "namespace_id": "840101",
          "simple": {
            "limit": 600,
            "period": 60,
          },
        },
      ],
      "routes": [
        {
          "pattern": "monthwise.online",
          "custom_domain": true,
        },
      ],
      "observability": {
        "enabled": true,
        "redact_query_string": true,
        "logs": {
          "enabled": true,
          "invocation_logs": false,
          "head_sampling_rate": 1,
        },
        "traces": {
          "enabled": false,
        },
      },
    },
  },
  "account_id": "ed9f9186f4199034f2499cf3da347885",
}
