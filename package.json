{
  "name": "monthwise",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.21.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc -b && tsc -p tsconfig.worker.json && vite build && node scripts/pwa-build.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc -b && tsc -p tsconfig.worker.json",
    "test": "vitest run",
    "dev:ui": "vite --host 127.0.0.1",
    "db:local": "wrangler d1 migrations apply DB --local --env local",
    "test:e2e": "playwright test",
    "test:pwa": "playwright test --config playwright.pwa.config.ts",
    "check": "npm run format:check && npm run typecheck && npm test && npm run test:performance && npm run test:recovery && npm run build && npm run test:e2e && npm run test:pwa && npm run test:cross && npm run test:pwa:cross",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "deploy:personal": "npm run build && wrangler deploy --env personal",
    "deploy:public": "node scripts/check-public-config.mjs && npm run build && wrangler deploy --env public",
    "test:cross": "playwright test --config playwright.cross.config.ts",
    "test:performance": "vitest run --config vitest.performance.config.ts",
    "backup:public": "node scripts/backup-public.mjs",
    "recovery:check": "node scripts/recovery-check.mjs",
    "test:recovery": "node scripts/test-recovery.mjs",
    "test:pwa:cross": "playwright test --config playwright.pwa.cross.config.ts"
  },
  "dependencies": {
    "exceljs": "^4.4.0",
    "jose": "^6.2.12",
    "oauth4webapi": "^3.8.8",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@cloudflare/workers-types": "^5.20261019.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.4.0",
    "miniflare": "^5.20261019.0-beta",
    "prettier": "^3.9.10",
    "typescript": "~5.8.3",
    "vite": "^6.3.0",
    "vitest": "^5.0.5",
    "wrangler": "^4.151.2"
  },
  "overrides": {
    "miniflare": {
      "undici": "^7.30.1"
    },
    "exceljs": {
      "uuid": "^11.1.1"
    }
  }
}
