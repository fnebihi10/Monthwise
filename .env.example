# Hosted configuration names only. Do not add secrets to VITE_ variables.
APP_ORIGIN=https://YOUR-WORKER.YOUR-SUBDOMAIN.workers.dev
OWNER_EMAIL=your-google-email@example.com
GOOGLE_CLIENT_ID=your-web-client.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET must be entered through wrangler secret put or the Cloudflare dashboard.
# npm run dev uses an explicit local development identity and does not need Google credentials.
